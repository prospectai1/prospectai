# Copy this file's variable NAMES into Vercel -> Project -> Settings -> Environment
# Variables. Never fill in real values here or commit real values to GitHub —
# this file only documents which variables exist.

# Supabase (Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apollo.io (Settings -> API in your Apollo dashboard)
APOLLO_API_KEY=

# Anthropic / Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Resend (resend.com -> API Keys)
RESEND_API_KEY=
# Must be on a domain/subdomain you've verified in Resend, e.g. mail.yourdomain.com
RESEND_FROM_ADDRESS=ProspectAI <outreach@yourdomain.com>
UNSUBSCRIBE_EMAIL=unsubscribe@yourdomain.com

# Site-wide Basic Auth (protects the entire site, since this is a private,
# single-firm tool with no per-user login system) — pick your own values.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=
